# Geminicli2api 环境变量示例 (.env)
# 复制本文件为 .env 后，再按需修改变量值。

########################
# 基础服务配置
########################

# 服务监听地址（默认 0.0.0.0，表示监听所有网卡）
HOST=0.0.0.0

# 服务监听端口（默认 7861）
PORT=7861

# 接口访问密码（用于 /v1 等 API 调用鉴权）
API_PASSWORD=your_api_key

# 控制面板访问密码（用于 Web 控制台登录）
PANEL_PASSWORD=your_password

# 通用密码（兼容旧版本，如果未设置 API_PASSWORD/PANEL_PASSWORD 时作为默认值；默认 pwd）
#PASSWORD=pwd

########################
# 日志配置
########################

# 日志级别：debug / info / warning / error / critical（默认 info）
#LOG_LEVEL=info

# 日志文件路径（默认 log.txt）
#LOG_FILE=log.txt

# 调用追踪日志文件路径（用于记录每次请求的详细阶段与耗时）
# 默认写入工作目录下的 call_trace.log；在官方 Dockerfile 中 WORKDIR=/app，因此默认实际路径为 /app/call_trace.log
# 如果希望单独挂载追踪日志（推荐），可以在 Docker 中这样配置：
#   -v /host/path/call_trace.log:/app/call_trace.log
# 如需自定义路径，则同时设置：
#   CALL_TRACE_LOG_FILE=/app/logs/call_trace.log
#   -v /host/path/call_trace.log:/app/logs/call_trace.log
#CALL_TRACE_LOG_FILE=/app/call_trace.log

########################
# 凭证与存储
########################

# 凭证与配置文件存放目录（默认 ./creds，内部自动创建 creds.toml / config.toml）
#CREDENTIALS_DIR=./creds

# 是否自动从环境变量加载 Google 凭证（true/false，默认 false）
# 开启后会扫描形如 *_CREDENTIALS 的环境变量并写入本地凭证存储
#AUTO_LOAD_ENV_CREDS=false

########################
# 网络与代理配置
########################

# 出站 HTTP 代理地址，例如：http://127.0.0.1:7890
#PROXY=http://127.0.0.1:7890

# Google OAuth2 代理地址（默认 https://oauth2.googleapis.com）
#OAUTH_PROXY_URL=https://oauth2.googleapis.com

# Google APIs 代理地址（默认 https://www.googleapis.com）
#GOOGLEAPIS_PROXY_URL=https://www.googleapis.com

# Google Cloud Resource Manager API 代理地址
# 默认 https://cloudresourcemanager.googleapis.com
#RESOURCE_MANAGER_API_URL=https://cloudresourcemanager.googleapis.com

# Google Cloud Service Usage API 代理地址
# 默认 https://serviceusage.googleapis.com
#SERVICE_USAGE_API_URL=https://serviceusage.googleapis.com

# Code Assist 后端接口地址（默认 https://cloudcode-pa.googleapis.com）
#CODE_ASSIST_ENDPOINT=https://cloudcode-pa.googleapis.com

########################
# OAuth 回调配置
########################

# 本地 OAuth 回调端口（用于桌面授权流程，默认 8080）
#OAUTH_CALLBACK_PORT=8080

########################
# 调用配额与速率限制
########################

# 单个凭证在一次轮换中的最大调用次数（默认 75）
#CALLS_PER_ROTATION=75

# Pro 系列模型单用户每日默认调用额度（默认 75）
#DAILY_LIMIT_PRO_MODELS=75

# 所有模型合计单用户每日默认调用额度（默认 600）
#DAILY_LIMIT_TOTAL=600

########################
# 自动封禁与错误重试
########################

# 是否开启自动封禁异常凭证（true/false，默认 false）
#AUTO_BAN=false

# 触发自动封禁的 HTTP 状态码列表（逗号分隔，默认 401,403）
#AUTO_BAN_ERROR_CODES=401,403

# 是否开启对 429（限流）错误的自动重试（true/false，默认 true）
#RETRY_429_ENABLED=true

# 429 错误最大重试次数（默认 5）
#RETRY_429_MAX_RETRIES=5

# 429 错误重试间隔秒数（默认 1.0）
#RETRY_429_INTERVAL=1.0

########################
# 兼容模式与抗截断
########################

# 兼容模式：true/false，默认 true
# 开启后会把所有 system 消息转换为 user，提升对某些客户端 / SDK 的兼容性，
# 但可能略微降低模型对 system 指令的理解能力。
#COMPATIBILITY_MODE=true

# 抗截断最大重试次数的环境锁（可选）
# 设置任意值后，将禁止在控制面板中修改 anti_truncation_max_attempts 配置
# 实际重试次数请在控制面板或配置文件中调整（有效范围 1-10）
#ANTI_TRUNCATION_MAX_ATTEMPTS=1

########################
# 其他
########################

# 上游接口兼容保留字段，如需扩展可在此添加自定义环境变量
